# Build stage
FROM golang:1.23 as builder
WORKDIR /app
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o /bin/scheduler ./cmd/scheduler

# Final stage
FROM gcr.io/distroless/base-debian12
COPY --from=builder /bin/scheduler /scheduler
ENTRYPOINT ["/scheduler"]
